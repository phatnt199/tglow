config.toml
*.session
session
.env
.env.*

# Local cache
*.sqlite
*.sqlite-journal
*.sqlite-wal
# Anchored to repo root: unanchored `cache/` also matched src/core/cache/,
# the SQLite cache *source* directory, hiding it from `git status` entirely.
/cache/

# Editor / OS
.DS_Store
*.swp

# Agent working notes -- task briefs, reports and ledgers. Never published.
.superpowers/
